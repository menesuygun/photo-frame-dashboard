{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/google-tasks.js": {
      "maxDuration": 60
    },
    "api/sports.js": {
      "maxDuration": 40
    }
  },
  "rewrites": [
    {
      "source": "/api/eg-news",
      "destination": "/api/sports?kind=egnews"
    },
    {
      "source": "/api/household-photos",
      "destination": "/api/household?action=photos"
    },
    {
      "source": "/api/travel",
      "destination": "/api/calendar?action=travel"
    },
    {
      "source": "/api/prayers",
      "destination": "/api/weather?resource=prayers"
    },
    {
      "source": "/api/eg-schedules",
      "destination": "/api/sports?kind=eg-schedules"
    }
  ]
}
